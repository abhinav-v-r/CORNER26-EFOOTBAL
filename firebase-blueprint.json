{
  "entities": {
    "GroupMatch": {
      "title": "Group Match",
      "description": "Represents the score and state of a group match",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier of the match"
        },
        "team1Score": {
          "type": "number",
          "description": "Score of team 1"
        },
        "team2Score": {
          "type": "number",
          "description": "Score of team 2"
        },
        "completed": {
          "type": "boolean",
          "description": "Whether the match has finished"
        }
      },
      "required": ["id", "completed"]
    },
    "KnockoutMatch": {
      "title": "Knockout Match",
      "description": "Represents the score and state of a knockout match",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier of the knockout match"
        },
        "team1Score": {
          "type": "number",
          "description": "Score of team 1"
        },
        "team2Score": {
          "type": "number",
          "description": "Score of team 2"
        },
        "completed": {
          "type": "boolean",
          "description": "Whether the match has finished"
        },
        "penalties1": {
          "type": "number",
          "description": "Penalty score of team 1 if drawn"
        },
        "penalties2": {
          "type": "number",
          "description": "Penalty score of team 2 if drawn"
        }
      },
      "required": ["id", "completed"]
    }
  },
  "firestore": {
    "group_matches/{matchId}": {
      "schema": "GroupMatch",
      "description": "Stores group stage match scores and outcomes"
    },
    "knockout_matches/{matchId}": {
      "schema": "KnockoutMatch",
      "description": "Stores knockout stage match scores and outcomes"
    }
  }
}
