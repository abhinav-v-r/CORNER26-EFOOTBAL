rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net: Default Deny-All
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Group matches rule: Anyone can view scores. Only authorized admin can edit.
    match /group_matches/{matchId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.email == "admin12@corner.com";
    }

    // 3. Knockout matches rule: Anyone can view scores. Only authorized admin can edit.
    match /knockout_matches/{matchId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.email == "admin12@corner.com";
    }
  }
}
